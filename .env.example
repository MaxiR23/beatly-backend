ENV=development
LOG_LEVEL=INFO
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Must start with redis://, rediss:// or unix://; a value with no scheme
# fails Settings() at startup instead of degrading to "no cache".
REDIS_URL=redis://localhost:6379/0
# Supabase request limits, in seconds, all > 0 (see docs/adr/018). The
# defaults below apply when a variable is unset.
SUPABASE_CONNECT_TIMEOUT=2.0
SUPABASE_READ_TIMEOUT=4.0
SUPABASE_WRITE_TIMEOUT=2.0
SUPABASE_POOL_TIMEOUT=2.0
# Total time a request may take before its single GET retry is skipped.
SUPABASE_REQUEST_BUDGET=10.0
# A request slower than this logs one supabase_slow warning.
SUPABASE_SLOW_REQUEST_THRESHOLD=1.0
# Response gzip: body size in bytes below which nothing is compressed
# (>= 0) and the zlib level (1-9); a value out of range fails at startup.
# The defaults below apply when a variable is unset.
GZIP_MINIMUM_SIZE=1024
GZIP_COMPRESSLEVEL=6
# Image colors (see docs/adr/021). Fetch timeout in seconds; download cap in
# bytes; pixel cap of a decoded image; seconds before a failed image is
# retried; seconds before an image claimed and not finished is taken as
# abandoned and computed again (above the fetch timeout, at most the retry
# window); images computed per request; computations at once per process.
IMAGE_COLOR_FETCH_TIMEOUT=3.0
IMAGE_COLOR_MAX_BYTES=262144
IMAGE_COLOR_MAX_PIXELS=4194304
IMAGE_COLOR_RETRY_AFTER=86400
IMAGE_COLOR_ABANDONED_AFTER=30
IMAGE_COLOR_MAX_PER_REQUEST=10
IMAGE_COLOR_MAX_PARALLEL_FETCHES=4
IMAGE_COLOR_PENDING_MAX_AGE=5
# Dark theme adjustment: the app background (#rrggbb, lowercase), the minimum
# WCAG contrast of the color against it and the minimum contrast white text
# keeps on top of it. A pair that cannot both be met fails at startup.
IMAGE_COLOR_BACKGROUND=#0e0e0e
IMAGE_COLOR_MIN_BACKGROUND_CONTRAST=1.5
IMAGE_COLOR_MIN_WHITE_TEXT_CONTRAST=4.5
# Hosts the color job may download from, exact hostnames, as JSON.
# IMPORTANT: IMAGE_COLOR_ALLOWED_HOSTS must be set for colors to appear;
# without it no image is downloaded and every color is null.
# IMAGE_COLOR_ALLOWED_HOSTS='["host1","host2"]'
